<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CRM – Reset Password</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Helvetica,
          Arial,
          sans-serif;
        background-color: #ede7da;
        color: #12271f;
      }

      a {
        text-decoration: none;
      }

      .container {
        max-width: 600px;
        margin: 40px auto;
        background-color: #fbf8f0;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(11, 29, 25, 0.1);
        overflow: hidden;
      }

      /* Header */
      .header {
        background-color: #0b1d19;
        border-bottom: 1px solid rgba(203, 161, 53, 0.3);
        text-align: center;
        padding: 36px 20px 32px;
      }

      .logo-mark {
        display: inline-block;
        width: 40px;
        height: 40px;
        border: 1px solid rgba(203, 161, 53, 0.5);
        border-radius: 10px;
        margin-bottom: 16px;
      }

      .logo-mark td {
        text-align: center;
        vertical-align: middle;
      }

      .wordmark {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 15px;
        font-weight: 600;
        color: #f4efe4;
        letter-spacing: 0.3px;
        margin: 0 0 20px;
      }

      .wordmark span {
        font-family: "Inter", Arial, sans-serif;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 2px;
        color: #cba135;
        text-transform: uppercase;
        margin-left: 4px;
      }

      .header h1 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 24px;
        font-weight: 600;
        color: #f4efe4;
        letter-spacing: 0.2px;
      }

      /* Body */
      .body {
        padding: 36px 32px;
      }

      .body p {
        font-size: 15px;
        line-height: 1.7;
        color: #5f6b63;
        margin: 16px 0;
      }

      .body strong {
        color: #12271f;
        font-weight: 600;
      }

      .body .accent {
        color: #8a6d1f;
        font-weight: 600;
      }

      /* Button */
      .button-wrap {
        text-align: center;
        margin: 28px 0 8px;
      }

      .button {
        display: inline-block;
        background-color: #cba135;
        color: #0b1d19 !important;
        font-family: "Inter", Arial, sans-serif;
        font-weight: 600;
        font-size: 15px;
        padding: 14px 32px;
        border-radius: 999px;
      }

      .button:hover {
        background-color: #e8c97a;
      }

      .expiry-note {
        text-align: center;
        font-family: "Inter", Arial, sans-serif;
        font-size: 11px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #8b9992;
        margin: 20px 0 0;
      }

      /* Footer */
      .footer {
        background-color: #fbf8f0;
        border-top: 1px dashed rgba(18, 39, 31, 0.12);
        text-align: center;
        font-size: 13px;
        padding: 24px 20px;
        color: #8b9992;
      }

      .footer p {
        margin: 6px 0;
      }

      .footer a {
        color: #8a6d1f;
        font-weight: 600;
      }

      .footer .copyright {
        font-size: 11px;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #b7c0ba;
      }

      /* Responsive */
      @media screen and (max-width: 600px) {
        .body {
          padding: 28px 20px;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <!-- Header -->
      <div class="header">
        <table
          role="presentation"
          class="logo-mark"
          cellpadding="0"
          cellspacing="0"
        >
          <tr>
            <td>
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#CBA135"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                <path
                  d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
                />
              </svg>
            </td>
          </tr>
        </table>
        <p class="wordmark">CRM<span>.ng</span></p>
        <h1>Password reset request</h1>
      </div>

      <!-- Body -->
      <div class="body">
        <p>Hello <strong><%= user.name %></strong>,</p>
        <p>
          We received a request to reset your password for your
          <strong>CRM</strong> account. Click the button below to securely
          set a new password. This link will expire in
          <span class="accent">15 minutes</span>.
        </p>

        <div class="button-wrap">
          <a href="<%= resetUrl %>" class="button">Reset password</a>
        </div>
        <p class="expiry-note">Link expires in 5 minutes</p>

        <p>
          If you didn’t request a password reset, you can safely ignore this
          email — your password will remain unchanged.
        </p>
      </div>

      <!-- Footer -->
      <div class="footer">
        <p>
          Need help? Contact our support team at
          <a href="mailto:support@crm.ng">support@crm.ng</a>
        </p>
        <p class="copyright">
          &copy; <%= new Date().getFullYear() %> CRM. All rights reserved.
        </p>
      </div>
    </div>
  </body>
</html>
